<Application x:Class="TermoDom.Studio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#15222D"/><SolidColorBrush x:Key="Line" Color="#2A3B48"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#0C151D"/><Setter Property="Foreground" Value="#E8F1F5"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#233B49"/><Setter Property="Foreground" Value="#ECF8FA"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101E28"/><Setter Property="Foreground" Value="#E8F1F5"/><Setter Property="CaretBrush" Value="#6ADCC6"/><Setter Property="BorderBrush" Value="#304653"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="110"/><Setter Property="Foreground" Value="#102029"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#101D27"/><Setter Property="Foreground" Value="#D5E5ED"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#101D27"/><Setter Property="BorderBrush" Value="#2A3B48"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,7"/></Style>
 </Application.Resources>
</Application>
