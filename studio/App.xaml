<Application x:Class="TermoDom.Studio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#202020"/><SolidColorBrush x:Key="Line" Color="#393939"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#181818"/><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="#ECECEC"/><Setter Property="CaretBrush" Value="#DDDDDD"/><Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="100"/><Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="Background" Value="#303030"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#303030" CornerRadius="7" Padding="8"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#CCCCCC"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Margin="9,8,23,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#303030" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="400"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,7"/><Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="Background" Value="#303030"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#202020"/><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#202020"/><Setter Property="BorderBrush" Value="#393939"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="Background" Value="#303030"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#484848"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
