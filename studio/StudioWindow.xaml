<Window x:Class="TermoDom.Studio.StudioWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="TermoDom Studio" Width="1360" Height="900" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="TermoDom" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="Priprema izoliranog Codexa…" Foreground="#A5A5A5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Promjene / terminal" Click="ToggleTools_Click"/><Button x:Name="Login" Content="Prijavi se kroz ChatGPT" Click="Login_Click"/><Button x:Name="Logout" Content="Odjava" Click="Logout_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="ToolsColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Background="#202020" CornerRadius="12" Padding="10"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="PROJEKT" Foreground="#999999" FontSize="11" Margin="7,8"/><TextBlock Text="TermoDom" FontSize="20" Margin="7,2,7,16"/>
     <Border Background="#303030" CornerRadius="8" Padding="12" Margin="4,0,4,14"><StackPanel><TextBlock Text="◉  Ovaj razgovor" FontWeight="SemiBold"/><TextBlock Text="Modernizuj aplikaciju za grijanje" FontSize="11" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
     <Button Content="GitHub repozitorij  ↗" Click="Repository_Click"/><Button Content="Osvježi datoteke" Click="Refresh_Click"/>
    </StackPanel>
    <DockPanel Margin="0,12,0,0"><TextBlock DockPanel.Dock="Top" Text="Datoteke projekta" Foreground="#A5A5A5" Margin="8,0,0,8"/><TextBox x:Name="Search" DockPanel.Dock="Top" ToolTip="Pretraži nazive datoteka" TextChanged="Search_Changed"/><ListBox x:Name="Files" SelectionChanged="Files_Selected" FontFamily="Consolas" FontSize="11"/></DockPanel>
   </DockPanel></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#181818" Padding="18,8"><DockPanel><TextBlock x:Name="ConversationTitle" DockPanel.Dock="Top" Text="Modernizuj aplikaciju za grijanje" FontSize="16" Margin="0,0,0,22"/><ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Chat" MaxWidth="900"/></ScrollViewer></DockPanel></Border>
    <Border Grid.Row="1" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="18" Padding="12" Margin="12,12,12,0"><StackPanel>
     <TextBox x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" Height="92" BorderThickness="0" Background="#252525" VerticalScrollBarVisibility="Auto" Margin="4" ToolTip="Nastavi rad na TermoDomu. Ctrl+Enter šalje poruku." KeyDown="Prompt_KeyDown"/>
     <DockPanel><Button x:Name="Attach" Content="＋ Privitak" Click="Attach_Click"/><Button x:Name="ClearAttachments" Content="Ukloni privitke" Click="ClearAttachments_Click" Visibility="Collapsed"/><TextBlock x:Name="AttachmentSummary" Foreground="#AAAAAA" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
     <WrapPanel><ComboBox x:Name="Models" Width="170" DisplayMemberPath="Label" SelectionChanged="Model_Changed" ToolTip="Model"/><ComboBox x:Name="Effort" Width="115" ToolTip="Razmišljanje"/><ComboBox x:Name="Speed" Width="125" DisplayMemberPath="Label" ToolTip="Brzina"/></WrapPanel>
     <ComboBox x:Name="Access" ToolTip="Oba načina rade samo unutar Windows Sandboxa. Standardni način dopušta da agent zatraži odobrenje; nije potvrda svake naredbe."><ComboBoxItem Content="Standardno • potvrde na zahtjev" IsSelected="True"/><ComboBoxItem Content="Full access • unutar Sandboxa"/></ComboBox>
     <DockPanel><Button x:Name="Send" Content="Pošalji  ↑" Click="Send_Click" Background="#ECECEC" Foreground="#111111"/><Button x:Name="Stop" Content="Zaustavi  ■" Click="Stop_Click"/><TextBlock x:Name="ContextUsage" Foreground="#999999" VerticalAlignment="Center" Margin="8,0" Text="Ctrl+Enter"/></DockPanel>
    </StackPanel></Border>
   </Grid>
   <Border x:Name="ToolPane" Grid.Column="4" CornerRadius="12" Background="#202020" Padding="9" Visibility="Collapsed"><TabControl>
    <TabItem Header="Uređivač"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="EditorName" Text="Odaberi datoteku projekta" TextTrimming="CharacterEllipsis" Margin="5,10"/><WrapPanel><Button Content="Spremi" Click="Save_Click"/><Button Content="Učitaj s diska" Click="Reload_Click"/></WrapPanel></StackPanel><TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="Editor_Changed"/></DockPanel></TabItem>
    <TabItem Header="Git"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="Status i diff" Click="Git_Click"/><Button Content="Spremi commit" Click="Commit_Click"/></WrapPanel><TextBox x:Name="Diff" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
    <TabItem Header="Terminal"><DockPanel><StackPanel DockPanel.Dock="Bottom"><TextBox x:Name="Command" AcceptsReturn="False" ToolTip="PowerShell naredba unutar Sandboxa"/><WrapPanel><Button Content="Pokreni" Click="Command_Click"/><Button Content="Zaustavi proces" Click="KillCommand_Click"/><Button Content="Windows testovi" Click="Test_Click"/><Button Content="Pripremi .NET SDK" Click="Tools_Click"/></WrapPanel></StackPanel><TextBox x:Name="Terminal" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
    <TabItem Header="Kontekst"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Context" TextWrapping="Wrap" Margin="10" Foreground="#C3D8DF"/></ScrollViewer></TabItem>
   </TabControl></Border>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="Status" Text="Projekt i razgovori ostaju u zasebnim podacima Studija." TextWrapping="Wrap" FontSize="11" Foreground="#92ABB8" Margin="5,12,5,0"/>
 </Grid>
</Window>
